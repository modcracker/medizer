rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'domainmod@gmail.com' && request.auth.token.email_verified == true)
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Leads validation
    function isValidLead(data) {
      return data.keys().hasAll(['email', 'name', 'createdAt', 'status', 'bio', 'reference']) &&
             data.keys().size() == 6 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.bio is string && data.bio.size() <= 1000 &&
             data.reference is string && data.reference.size() <= 200 &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    // Support ticket validation
    function isValidSupportTicket(data) {
      return data.keys().hasAll(['email', 'name', 'subject', 'message', 'status', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() <= 100 &&
             data.subject is string && data.subject.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.status == 'unread' &&
             data.createdAt == request.time;
    }

    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isValidId(ticketId) && isValidSupportTicket(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /search_index/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Only manageable via console
    }
  }
}
